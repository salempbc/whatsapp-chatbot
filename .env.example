# ==============================================================================
# SPBC CHURCH CMS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env (for local/production) or .env.staging (for staging).
# Never commit actual credentials or secrets to version control.
# ==============================================================================

# Server Environment & Port
NODE_ENV=staging
PORT=3000

# MongoDB Configuration (Atlas or local instance)
MONGO_URI=<STAGING_MONGO_URI>
MONGO_DB_NAME=spbc_staging

# Telegram Bot Configuration
BOT_TOKEN=<STAGING_BOT_TOKEN>
ADMIN_ID=<STAGING_ADMIN_ID>

# WebApp Security Secret (Minimum 32 characters for standalone diagnostics & API)
ADMIN_SECRET=<STAGING_ADMIN_SECRET>

# Public WebApp URL (HTTPS endpoint served by Render/Railway/custom domain)
WEBAPP_URL=<STAGING_WEBAPP_URL>

# Optional: Google Gemini AI API Configuration
GEMINI_API_KEY=<STAGING_GEMINI_API_KEY>
GEMINI_MODEL=<STAGING_GEMINI_MODEL>

# Optional: Webhook Secret Token for Telegram Webhook validation
WEBHOOK_SECRET=<STAGING_WEBHOOK_SECRET>
